# Copy this file to .env for local dev — `vercel dev` (see package.json's
# "dev:full" script) loads .env automatically by its own convention, no
# custom loader needed. Set the same variable as a Vercel project
# environment variable (Settings -> Environment Variables) for deployment.
# Never commit the real key — .env is already git-ignored.

ANTHROPIC_API_KEY=your_anthropic_api_key_here
